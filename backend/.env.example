# Meta Model API key (dev.meta.ai -> API keys)
MODEL_API_KEY=

# Facebook Graph API
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v26.0

PORT=4000

# Supabase (Project Settings -> API). Service key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: Baseten hosts Muse Spark Open for bulk tasks. Any Baseten failure falls back to muse-spark-1.3 on the Meta API.
BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open-1026   # the hackathon key only works with this exact id
# Which provider runs bulk tasks (comment classification, post tagging, playbook): baseten (default) or meta.
# BULK_PROVIDER=baseten
# Override one task: PROVIDER_COMMENT_CLASSIFICATION, PROVIDER_POST_TAGGING, PROVIDER_PLAYBOOK, PROVIDER_POST_GENERATION

# Post generation runs as a tool-calling agent. AGENT_MODE=off goes back to the single-call writer.
# AGENT_MODE=on
# AGENT_REASONING_EFFORT=low

# Catalog extraction reads this many of the newest tagged posts (more posts = more model calls)
# CATALOG_POST_LIMIT=800

# Stock import: the low-stock level is a per-page setting on the Catalog screen (default 3)

# Page sessions are signed with a key derived from FB_APP_SECRET; set SESSION_SECRET to use a separate one
# SESSION_SECRET=
