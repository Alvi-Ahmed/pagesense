# Meta Model API key (dev.meta.ai -> API keys)
MODEL_API_KEY=

# Facebook Graph API
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v26.0

PORT=4000

# Supabase (Project Settings -> API). Service key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: Baseten hosts Muse Spark Open for bulk tasks. Any Baseten failure falls back to muse-spark-1.3 on the Meta API.
BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open
# Which provider runs bulk tasks (comment classification, post tagging, playbook): meta (default) or baseten.
# BULK_PROVIDER=meta
# Override one task: PROVIDER_COMMENT_CLASSIFICATION, PROVIDER_POST_TAGGING, PROVIDER_PLAYBOOK, PROVIDER_POST_GENERATION
